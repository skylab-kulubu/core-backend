      "types": ["application/zip", "application/pdf"],
      "max_mib": 1024,
      "visibility": "private",
      "encrypted": true,
      "scan": true,
      "pending_ttl": "24h",
      "transport": "direct",
      "attach": "service",
      "service": "forms"
    },
    "video": {
      "description": "An event recording, served as plain MP4.",
      "upload": "event_editor",
      "types": ["video/mp4"],
      "max_mib": 2048,
      "visibility": "public",
      "encrypted": false,
      "scan": false,
      "pending_ttl": "24h",
      "transport": "direct",
      "attach": "service"
    },
    "legacy": {
      "description": "Media uploaded without a purpose, and every Media stored before Media purpose. Internal: clients cannot name it. It keeps the rules Media uploaded without a purpose had before this catalogue, until Skyforms and CMS send purposes. Its images keep their own bytes, stripped of metadata, and get no sizes.",
      "upload": "authenticated",
      "legacy_rules": true,
      "visibility": "public",
      "encrypted": false,
      "scan": false,
      "pending_ttl": "none",
      "transport": "single_step",
      "attach": "core"
    }
  }
