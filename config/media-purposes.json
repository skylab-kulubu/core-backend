      "types": ["application/pdf"],
      "max_mib": 1024,
      "visibility": "public",
      "encrypted": false,
      "scan": true,
      "pending_ttl": "24h",
      "transport": "direct",
      "attach": "service"
    },
    "answer_file_large": {
      "description": "A large Answer file, such as a game-jam build. Skyforms grants the Direct upload.",
