{
  "purposes": {
    "profile_picture": {
      "description": "A person's own profile picture, set through /v1/users/me/profile-picture.",
      "upload": "authenticated",
      "types": ["image/jpeg", "image/png", "image/webp", "image/gif"],
      "max_mib": 5,
      "visibility": "public",
      "encrypted": false,
      "scan": false,
      "pending_ttl": "24h",
      "transport": "single_step",
      "attach": "core",
      "image": { "reencode": true, "max_dimension": 2560, "sizes": { "card": 400, "page": 1200 } }
    },
    "event_cover": {
      "description": "An Event's cover image.",
