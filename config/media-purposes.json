      "max_mib": 20,
      "visibility": "private",
      "encrypted": true,
      "scan": false,
      "pending_ttl": "24h",
      "transport": "single_step",
      "attach": "core",
      "image": { "reencode": true, "max_dimension": 2560 }
    },
    "cms_image": {
      "description": "An image on a CMS page. An SVG is stored sanitized and served as a download.",
      "upload": "authenticated",
      "types": ["image/jpeg", "image/png", "image/webp", "image/gif", "image/svg+xml"],
      "max_mib": 10,
      "visibility": "public",
      "encrypted": false,
      "scan": false,
      "pending_ttl": "24h",
      "transport": "single_step",
      "attach": "service",
      "service": "cms",
      "image": { "reencode": true, "max_dimension": 2560, "sizes": { "card": 400, "page": 1200 } }
    },
    "cms_file": {
      "description": "A document anyone can open from a CMS page, such as bylaws or a brochure.",
      "upload": "authenticated",
      "types": ["application/pdf"],
      "max_mib": 20,
      "visibility": "public",
      "encrypted": false,
      "scan": false,
      "pending_ttl": "24h",
      "transport": "single_step",
      "attach": "service",
      "service": "cms"
    },
    "answer_file": {
      "description": "An Answer file: a person's file for a Skyforms file question. Skyforms decides who may open it.",
      "upload": "authenticated",
      "types": [
        "application/pdf",
        "image/jpeg",
        "image/png",
        "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
      ],
      "max_mib": 20,
      "visibility": "private",
      "encrypted": true,
      "scan": true,
      "pending_ttl": "24h",
      "transport": "single_step",
      "attach": "service",
      "service": "forms",
      "image": { "reencode": true, "max_dimension": 2560 }
    },
    "club_file": {
      "description": "A large club download, such as event material, that anyone can open.",
