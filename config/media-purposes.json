      "types": ["image/jpeg", "image/png", "image/webp", "image/gif", "image/svg+xml"],
      "max_mib": 10,
      "visibility": "public",
      "encrypted": false,
      "scan": false,
      "pending_ttl": "24h",
      "transport": "single_step",
      "attach": "core",
      "image": { "reencode": true, "max_dimension": 2560, "sizes": { "card": 400, "page": 1200 } }
    },
    "event_gallery": {
      "description": "A photo in an Event's gallery.",
      "upload": "event_editor",
      "types": ["image/jpeg", "image/png", "image/webp", "image/gif", "image/svg+xml"],
      "max_mib": 10,
      "visibility": "public",
      "encrypted": false,
      "scan": false,
      "pending_ttl": "24h",
      "transport": "single_step",
      "attach": "core",
      "image": { "reencode": true, "max_dimension": 2560, "sizes": { "card": 400, "page": 1200 } }
    },
